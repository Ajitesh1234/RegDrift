# Copy to .env and `export` the values, or add them as GitHub Actions secrets / Colab secrets.
# Everything is optional: with nothing set, RegDrift runs offline using keyword rules and a dry run.

# Free LLM (https://console.groq.com): extraction + reasoning. The code tries several Groq models
# and uses the first your account can access. Set GROQ_MODEL to force one.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Jira Cloud (free plan). Tickets are only created when all four are set and --dry-run is NOT passed.
JIRA_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=          # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_PROJECT=SCRUM   # project key (the prefix of your issue IDs)

# Your LoRA-tuned clause extractor (folder from train_lora.py). Needs torch + transformers + peft.
# LORA_ADAPTER=regdrift-lora

# Use a different bots file (e.g. one built with import_bot.py)
# REGDRIFT_BOTS=/path/to/bots.json

# Semantic-search strictness for bots that do not expose the rule's setting (0-1, default 0.35)
# CHROMA_MIN_SIM=0.35
